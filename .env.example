# CanvasFlow Environment Variables (Production & Local)
# Copy this template to .env.local for local testing, or add to Vercel Project Settings for Production.
# NEVER commit real credentials or .env.local to GitHub.

# ─── Authentication & Session Security (NextAuth.js / Auth.js v5) ────────
# Primary secret for encrypting JWT session tokens (at least 32 random characters).
# Generate using: openssl rand -base64 32
AUTH_SECRET=

# Required on Vercel, reverse proxies, and custom domains to trust the forwarded host header
AUTH_TRUST_HOST=true

# Canonical app URL for authentication callbacks (e.g. http://localhost:3000 or https://canvas-flow.vercel.app)
AUTH_URL=

# ─── Multi-Tenant Token Encryption (AES-256-GCM) ───────────────────────
# 32-byte hexadecimal encryption key for encrypting user Canvas access tokens at rest.
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Canvas LMS API ─────────────────────────────────────────────────────
# Default Canvas REST API URL (each user can also supply their institution's Canvas URL)
CANVAS_BASE_URL=https://canvas.elte.hu

# Optional server-side master Canvas token for global testing / single-tenant legacy mode
CANVAS_TOKEN=

# Set to "false" in Production. Only set to "true" for offline mock development.
CANVAS_MOCK_MODE=false

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────
# Connection Pooler URL (Supavisor port 6543, Transaction mode) for serverless queries
DATABASE_URL=

# Direct Connection URL (port 5432) used for Prisma migrations
DIRECT_URL=

# ─── Web Push Notifications (VAPID) ────────────────────────────────────
# Generate using: npx web-push generate-vapid-keys
# Public key exposed to the browser for push registration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-side VAPID private key (NEVER expose to the browser)
VAPID_PRIVATE_KEY=

# Contact mailto: URI for Web Push service identification
VAPID_SUBJECT=mailto:your-email@example.com

# ─── Cron Security ─────────────────────────────────────────────────────
# Strong random secret used by Vercel Cron or GitHub Actions to authorize scheduled runs
CRON_SECRET=

# ─── Application URLs ───────────────────────────────────────────────────
# Canonical production URL (e.g. https://your-domain.vercel.app or custom domain)
APP_URL=
NEXT_PUBLIC_APP_URL=
