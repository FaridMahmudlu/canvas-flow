{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  }
}
