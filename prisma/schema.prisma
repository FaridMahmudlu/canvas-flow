// Prisma schema for CanvasFlow
// PostgreSQL database schema configured for Supabase & Vercel serverless

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  canvasUserId Int      @unique
  name         String
  email        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notificationPreferences NotificationPreference?
  pushSubscriptions       PushSubscription[]
}

// ─── Course ────────────────────────────────────────────────────────────

model Course {
  id             String    @id @default(cuid())
  canvasCourseId Int       @unique
  name           String
  code           String?
  semester       String?
  workflowState  String    @default("available")
  color          String?
  timezone       String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tasks Task[]

  @@index([semester])
}

// ─── Task ──────────────────────────────────────────────────────────────

model Task {
  id              String    @id @default(cuid())
  canvasTaskId    String    @unique
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceType      String    // "assignment" | "quiz" | "event"
  title           String
  description     String?   @db.Text
  htmlUrl         String?
  availableAt     DateTime?
  dueAt           DateTime?
  lockAt          DateTime?
  isLocked        Boolean   @default(false)
  lockExplanation String?
  pointsPossible  Float?
  submissionTypes String[]  @default([])
  published       Boolean   @default(true)
  status          String    @default("available") // "upcoming" | "available" | "due-soon" | "overdue" | "submitted" | "completed" | "locked"

  // Submission fields
  isSubmitted     Boolean   @default(false)
  submittedAt     DateTime?
  submissionState String?
  grade           String?
  score           Float?
  attempt         Int?

  // Quiz-specific
  quizTimeLimit      Int?   // minutes
  quizAllowedAttempts Int?

  // Metadata
  rawMetadata  Json?
  lastSyncedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]

  @@index([courseId])
  @@index([dueAt])
  @@index([availableAt])
  @@index([status])
  @@index([sourceType])
  @@index([isSubmitted])
}

// ─── Notification ──────────────────────────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type         String   // "available" | "24h" | "6h" | "1h" | "overdue" | "new_task" | "changed"
  scheduledFor DateTime
  sentAt       DateTime?
  state          String   @default("pending") // "pending" | "sent" | "failed" | "skipped"
  errorMessage   String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@unique([taskId, type, scheduledFor])
  @@index([scheduledFor])
  @@index([state])
  @@index([state, scheduledFor])
  @@index([taskId])
}

// ─── Notification Preferences ──────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAvailable    Boolean @default(true)
  before24h        Boolean @default(true)
  before6h         Boolean @default(true)
  before1h         Boolean @default(true)
  overdue          Boolean @default(true)
  newAssignments   Boolean @default(true)
  newQuizzes       Boolean @default(true)
  changedDeadlines Boolean @default(true)
  quietHoursStart  String? // "22:00"
  quietHoursEnd    String? // "08:00"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Push Subscription ─────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Sync Run ──────────────────────────────────────────────────────────

model SyncRun {
  id                     String    @id @default(cuid())
  status                 String    // "running" | "completed" | "failed" | "rate_limited" | "skipped"
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  durationMs             Int?
  coursesCount           Int?
  tasksCount             Int?
  newTasks               Int?      @default(0)
  updatedTasks           Int?      @default(0)
  notificationsCount     Int?      @default(0)
  rateLimitRemaining     Float?
  requestCost            Float?
  httpStatus             Int?
  backoffSeconds         Int?
  targetIntervalSeconds  Int?      @default(60)
  currentIntervalSeconds Int?      @default(60)
  detectionLatencyMs     Int?
  errorMessage           String?
  errorType              String?   // "429" | "401" | "403" | "timeout" | "network"
  triggeredBy            String?   // "manual" | "cron" | "auto" | "adaptive"

  @@index([status, startedAt])
}

// ─── Sync State (Adaptive Controller Singleton) ────────────────────────

model SyncState {
  id                      String    @id @default("global")
  targetIntervalSeconds   Int       @default(60)
  currentIntervalSeconds  Int       @default(60)
  consecutiveSuccesses    Int       @default(0)
  lastRateLimitRemaining  Float?
  lastRequestCost         Float?
  last429At               DateTime?
  backoffUntil            DateTime?
  lastSyncAt              DateTime?
  lastSuccessSyncAt       DateTime?
  lastDetectionLatencyMs  Int?
  avgDetectionLatencyMs   Int?
  worstDetectionLatencyMs Int?
  updatedAt               DateTime  @updatedAt
}
